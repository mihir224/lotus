GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
EMBEDDING_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_GENAI_USE_VERTEXAI=false
RUNTIME_MODE=fixture
EMBEDDING_RUNTIME_MODE=fixture
STORE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://lotus:lotus@localhost:5432/lotus
# Cloud Run uses these settings instead of DATABASE_URL. DB_PASSWORD is injected
# from Secret Manager and must never be committed.
CLOUD_SQL_INSTANCE=
DB_USER=lotus_app
DB_NAME=lotus
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
GENERATION_MODEL=gemini-3.7-flash
ROUTER_MODEL=gemini-3.7-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
AGENT_TIMEOUT_SECONDS=90
WEB_AGENT_TIMEOUT_SECONDS=180
AUTH_MODE=dev
GOOGLE_OAUTH_CLIENT_ID=
ALLOWED_GOOGLE_EMAILS=
ALLOWED_GOOGLE_DOMAINS=
AGENT_RATE_LIMIT_REQUESTS=10
AGENT_RATE_LIMIT_WINDOW_SECONDS=300
TELEMETRY_ENABLED=false
BIGQUERY_DATASET=lotus_knowledge
PRODUCT_TABLE=product_chunks
TECHNICAL_TABLE=technical_chunks
MEETING_TABLE=meeting_chunks
FIRESTORE_DATABASE=(default)
ARTIFACT_BUCKET=
TASK_QUEUE_LOCATION=
TASK_QUEUE_NAME=
JIRA_MCP_URL=
CONFLUENCE_MCP_URL=
JIRA_SECRET_RESOURCE=
CONFLUENCE_SECRET_RESOURCE=
MEETING_RETENTION_DAYS=7
PATCH_RETENTION_DAYS=7
DEMO_MODE=true
